  log "Generated VS Code keybindings"
}

generate_context_provider() {
  cat > "$VSCODE_DIR/ash-context-provider.js" << 'JSEOF'
// Ash Context Provider — injects NotebookLM + file context into VS Code editors
const vscode = require('vscode');
const fs = require('fs');
const path = require('path');
const http = require('http');

class AshContextProvider {
    constructor() {
        this.contextChanged = new vscode.EventEmitter();
        this.onDidChangeContext = this.contextChanged.event;
    }

    async getContext(query) {
        const contexts = {
            files: await this.getFileContext(query),
            notebooklm: await this.getNotebookLMContext(query),
            web: []
        };
        return contexts;
    }

    async getFileContext(query) {
        try {
            const result = execSync(`ash context "${query}" --source files --no-context 2>/dev/null`, { encoding: 'utf8' });
            return JSON.parse(result);
        } catch(e) {
            return [];
        }
    }

    async getNotebookLMContext(query) {
        try {
            const result = execSync(`ash context "${query}" --source notebooklm --no-context 2>/dev/null`, { encoding: 'utf8' });
            return JSON.parse(result);
        } catch(e) {
            return [];
        }
    }

    async getWebContext(query) {
        try {
            const result = execSync(`ash context "${query}" --source web --no-context 2>/dev/null`, { encoding: 'utf8' });
            return JSON.parse(result);
        } catch(e) {
            return [];
        }
    }
}

module.exports = { AshContextProvider };
JSEOF
  log "Generated context provider"
}

generate_notebooklm_provider() {
  cat > "$VSCODE_DIR/ash-notebooklm-provider.js" << 'JSEOF'
// Ash NotebookLM Provider — syncs NotebookLM notebooks into VS Code side panel
const vscode = require('vscode');
const { execSync } = require('child_process');

function activate(context) {
    const treeProvider = new AshNotebookLMProvider();
    const treeView = vscode.window.createTreeView('ash-notebooklm', { treeDataProvider: treeProvider });
    
    vscode.commands.registerCommand('ash-vibe.syncNotebookLM', () => {
        vscode.window.showInformationMessage('Syncing NotebookLM notebooks...');
        try {
            execSync('ash vibe sync', { encoding: 'utf8' });
            vscode.window.showInformationMessage('NotebookLM sync complete');
            treeProvider.refresh();
        } catch(e) {
            vscode.window.showErrorMessage('NotebookLM sync failed: ' + e.message);
        }
    });

    vscode.commands.registerCommand('ash-vibe.injectContext', () => {
        const editor = vscode.window.activeTextEditor;
        if (!editor) return;
        const query = editor.document.getText().substring(0, 200);
        try {
            const result = execSync(`ash context "${query}" --no-context 2>/dev/null`, { encoding: 'utf8' });
            const position = new vscode.Position(0, 0);
            editor.edit(editBuilder => {
                editBuilder.insert(position, `# Ash Context:\n${result}\n\n`);
            });
        } catch(e) {
            // Context unavailable — silent
        }
    });

    context.subscriptions.push(treeView);
}

class AshNotebookLMProvider {
    constructor() {
        this._onDidChangeTreeData = new vscode.EventEmitter();
        this.onDidChangeTreeData = this._onDidChangeTreeData.event;
        this._notebooks = [];
        this.refresh();
    }

    refresh() {
        try {
            const result = execSync('curl -s http://localhost:3000/api/notebooks 2>/dev/null', { encoding: 'utf8' });
            this._notebooks = JSON.parse(result).notebooks || [];
        } catch(e) {
            this._notebooks = [];
        }
        this._onDidChangeTreeData.fire();
    }

    getTreeItem(element) {
        return {
            label: element.title || 'untitled',
            collapsibleState: vscode.TreeItemCollapsibleState.None,
            command: {
                command: 'ash-vibe.injectNotebookContext',
                title: 'Inject Notebook Context',
                arguments: [element.id]
            }
        };
    }

    getChildren(element) {
        if (element) return [];
        return this._notebooks.map(nb => ({ id: nb.id, title: nb.title || 'untitled' }));
    }
}

module.exports = { activate };
JSEOF
  log "Generated NotebookLM provider"
}

enable_extension() {
  if [[ -f "$VSCODE_DIR/extensions.json" ]]; then
    python3 -c "
import json
with open('$VSCODE_DIR/extensions.json') as f:
    data = json.load(f)
if 'ash-vibe' not in str(data):
    data['recommendations'] = data.get('recommendations', [])
    data['recommendations'].append('ash-vibe.ash-vscode')
with open('$VSCODE_DIR/extensions.json', 'w') as f:
    json.dump(data, f, indent=2)
print('Updated extensions.json')
" 2>/dev/null || true
  fi
}

inject_context() {
  log "Injecting NotebookLM context into VS Code..."
  if [[ "$(uname)" == "Darwin" ]]; then
    osascript -e 'tell application "Visual Studio Code" to activate' 2>/dev/null || true
  fi
  vscode --wait 2>/dev/null || true
}

sync_notebooklm_vscode() {
  log "Syncing NotebookLM for VS Code..."
  python3 "$HOME_DIR/ai-services/tools/notebooklm-sync/src/sync.py" 2>/dev/null || true
}

show_vscode_status() {
  echo "📝 Ash VS Code Integration Status"
  echo "================================"
  echo "Settings:     $VSCODE_SETTINGS"
  echo "Terminal hook: $VSCODE_TERMINAL"
  echo "Commands:     $VSCODE_COMMANDS"
  echo "Context:      $VSCODE_DIR/ash-context-provider.js"
  echo "NotebookLM:   $VSCODE_DIR/ash-notebooklm-provider.js"
  if [[ -f "$VSCODE_SETTINGS" ]]; then
    echo "Status:       ✅ Installed"
  else
    echo "Status:       ❌ Not installed"
  fi
}