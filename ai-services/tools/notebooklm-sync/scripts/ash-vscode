#!/bin/bash
# ash vscode — vibe-coding integration for VS Code with auto-context injection
set -euo pipefail

HOME_DIR="${HOME:-/home/shrey}"
ASH_DIR="$HOME_DIR/.ash"
VSCODE_DIR="$HOME_DIR/.vscode"
VSCODE_SETTINGS="$VSCODE_DIR/settings.json"
VSCODE_TERMINAL="$VSCODE_DIR/ash-vibe-terminal.js"
VSCODE_COMMANDS="$VSCODE_DIR/ash-commands.json"
QDRANT_URL="${QDRANT_URL:-http://localhost:6333}"
NOTEBOOKLM_API="${NOTEBOOKLM_API:-http://localhost:3000}"
OLLAMA_URL="${OLLAMA_URL:-http://localhost:11434/api/embeddings}"
ASH_MODEL="${ASH_MODEL:-nomic-embed-text}"

mkdir -p "$VSCODE_DIR"

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
  install)
    log "Installing VS Code vibe-coding integration..."
    backup_settings
    generate_settings
    generate_terminal_hook
    generate_commands
    generate_context_provider
    generate_notebooklm_provider
    enable_extension
    log "✅ ash-vscode installed in $VSCODE_DIR"
    log "   Reload VS Code to activate"
    log "   Shortcut: Ctrl+Shift+H for vibe context"
    ;;
  context)
    inject_context
    ;;
  notebooklm)
    sync_notebooklm_vscode
    ;;
  status)
    show_vscode_status
    ;;
  --help|help|*)
    cat <<'HELP'
ash vscode — vibe-coding integration for VS Code

Commands:
  ash vscode install      Install the VS Code integration
  ash vscode context      Inject NotebookLM context into active editor
  ash vscode notebooklm   Sync NotebookLM notebooks for VSC support
  ash vscode status       Show integration status
  ash vscode --help       Show this help

VS Code Features:
  • Ctrl+Shift+H — Open vibe context panel (NotebookLM + file search)
  • Ctrl+Shift+N — Quick NotebookLM query
  • Ctrl+Shift+W — Web research on selected text
  • Ctrl+Shift+S — Save workspace snapshot
  • Auto context — NotebookLM summaries prepended to new editors
  • Chat context — Ash context injected into AI chat provider
HELP
    ;;
esac

log() { echo "[$(date '+%H:%M:%S')] $*" >> "$ASH_DIR/vscode.log"; echo "$*"; }

backup_settings() {
  if [[ -f "$VSCODE_SETTINGS" ]]; then
    cp "$VSCODE_SETTINGS" "$VSCODE_SETTINGS.bak.$(date +%s)" 2>/dev/null || true
  fi
}

generate_settings() {
  cat > "$VSCODE_SETTINGS" << 'JSON'
{
  "ash.context.notebooklm": true,
  "ash.context.webSearch": true,
  "ash.context.autoInject": true,
  "ash.context.maxTokens": 2000,
  "ash.notebooklm.syncOnStart": true,
  "ash.vibe.mode": "full",
  "ash.vibe.snapshotOnChange": true,
  "ash.qdrant.url": "http://localhost:6333",
  "ash.ollama.url": "http://localhost:11434",
  "ash.model": "nomic-embed-text",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "editor.wordWrap": "on",
  "editor.minimap.maxColumn": 120,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.scrollback": 10000,
  "workbench.colorTheme": "Default Dark+",
  "telemetry.enabled": false,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter": "left"
  }
}
JSON
  log "Generated VS Code settings with ash config"
}

generate_terminal_hook() {
  cat > "$VSCODE_TERMINAL" << 'JSEOF'
// Ash Vibe Terminal Hook — auto-injects context into VS Code terminal
const vscode = require('vscode');
const { execSync } = require('child_process');

function activate(context) {
    const disposable = vscode.commands.registerCommand('ash-vibe.terminalContext', () => {
        const terminal = vscode.window.activeTerminal;
        if (!terminal) return;
        
        try {
            const context = execSync('ash context "current project context" --no-context 2>/dev/null', { encoding: 'utf8' });
            if (context && context.trim()) {
                terminal.sendText(`# Ash Context:\n# ${context.trim().split('\n').join('\n# ')}`);
            }
        } catch(e) {
            // Context unavailable — not an error
        }
        
        terminal.sendText('echo "🚀 Vibe mode context injected"');
    });
    context.subscriptions.push(disposable);
}

function deactivate() {}

module.exports = { activate, deactivate };
JSEOF
  log "Generated terminal hook script"
}

