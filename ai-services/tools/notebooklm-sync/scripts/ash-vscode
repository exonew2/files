      "title": "Vibe: Query NotebookLM",
      "category": "Ash"
    },
    {
      "command": "ash-vibe.webResearch",
      "title": "Vibe: Research Selection",
      "category": "Ash"
    },
    {
      "command": "ash-vibe.takeSnapshot",
      "title": "Vibe: Snapshot Workspace",
      "category": "Ash"
